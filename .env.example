# ---------------------------------------------------------------------------
# Pure Max Factory OS — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in whatever you actually use.
# Every variable below is OPTIONAL: the app is designed to run fully
# client-side (localStorage + IndexedDB) with no backend at all, which is what
# makes it work on a static GitHub Pages deploy and inside Google AI Studio.
# ---------------------------------------------------------------------------

# Google Maps JavaScript API key.
#   Set it  -> the Fleet GPS map boots on Google Maps.
#   Unset   -> the map boots on Leaflet + OpenStreetMap instead, which needs no
#              key and no billing. This is now the DEFAULT, because the module
#              previously hard-coded a third-party key that would fail quota /
#              billing and leave a blank grey viewport.
VITE_GOOGLE_MAPS_API_KEY=

# --- PostgreSQL (optional; only used when you run the Node server) ----------
# Without these, every /api/* call fails and the app runs purely on browser
# storage. That is the normal situation inside Google AI Studio.
# SQL_HOST=
# SQL_DB_NAME=
# SQL_USER=
# SQL_PASSWORD=
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=

# --- Password reset: email channel (optional) -------------------------------
# Used by POST /api/auth/request-reset to email the 6-digit OTP.
# If unset, the server reports honestly that email is unavailable.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Pure Max Factory <no-reply@puremax.sl>"

# --- Password reset: WhatsApp channel (optional) ----------------------------
# Meta WhatsApp Business Cloud API. Without these the WhatsApp option
# transparently falls back to email rather than silently doing nothing.
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Set to "production" to stop the API returning dev-only OTP codes.
# NODE_ENV=production
